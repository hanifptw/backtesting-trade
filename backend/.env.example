# Binance API credentials (testnet by default — see EXCHANGE_TESTNET below).
# Get keys from: https://testnet.binancefuture.com  (futures testnet)
#            or: https://testnet.binance.vision     (spot testnet)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Set to "true" to route CCXT to Binance testnet/sandbox. "false" = live mainnet.
EXCHANGE_TESTNET=true
